[
  {
    "name": "basic correction",
    "entries": [
      {
        "kind": "correction",
        "hear": "cloud code",
        "write": "Claude Code"
      }
    ],
    "input": "I use cloud code daily",
    "expected": "I use Claude Code daily",
    "applied": [
      {
        "from": "cloud code",
        "to": "Claude Code",
        "count": 1
      }
    ]
  },
  {
    "name": "case-insensitive match, replacement keeps the stored casing",
